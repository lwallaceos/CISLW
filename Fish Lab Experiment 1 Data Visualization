        "import matplotlib.pyplot as plt\n",
        "import numpy as np\n",
        "\n",
        "categories = [\"Reduced\", \"Complete\", \"Absent\"]\n",
        "bear_paw = [7, 8, 5]\n",
        "frog = [0, 20, 0]\n",
        "\n",
        "x = np.arange(len(categories))\n",
        "width = 0.35\n",
        "\n",
        "fig, ax = plt.subplots()\n",
        "bars1 = ax.bar(x - width / 2, bear_paw, width, label=\"Bear Paw Lake\", color=\"blue\")\n",
        "bars2 = ax.bar(x + width / 2, frog, width, label=\"Frog Lake\", color=\"orange\")\n",
        "\n",
        "ax.set_ylabel(\"Number of Fish\")\n",
        "ax.set_title(\"Comparison of Stickleback Pelvic Structures\")\n",
        "ax.set_xticks(x)\n",
        "ax.set_xticklabels(categories)\n",
        "ax.legend()\n",
        "\n",
        "plt.show()\n"
      ]
