      "source": [
        "import matplotlib.pyplot as plt\n",
        "import numpy as np\n",
        "\n",
        "layers = np.arange(1, 7)\n",
        "complete = [20, 18, 3, 1, 0, 0]\n",
        "reduced = [0, 2, 16, 19, 15, 16]\n",
        "absent = [0, 0, 1, 0, 5, 4]\n",
        "\n",
        "plt.figure(figsize=(10, 6))\n",
        "\n",
        "plt.plot(layers, complete, 'o-', color='#2ca02c', linewidth=2, markersize=8, label='Complete')\n",
        "plt.plot(layers, reduced, 's--', color='#d62728', linewidth=2, markersize=8, label='Reduced')\n",
        "plt.plot(layers, absent, '^:', color='#9467bd', linewidth=2, markersize=8, label='Absent')\n",
        "\n",
        "plt.title('Fossil Stickleback Pelvic Phenotype Totals\\nAcross Sediment Layers', fontsize=14, pad=20)\n",
        "plt.xlabel('Fossil Layer',fontsize = 12 )\n",
        "plt.ylabel('Number of Fossils', fontsize=12)\n",
        "plt.xticks(layers)\n",
        "plt.grid(True, linestyle='--', alpha=0.7)\n",
        "\n",
        "plt.legend(fontsize=12)\n",
        "for x, y in zip(layers, complete):\n",
        "    plt.text(x, y+0.5, f'{y}', ha='center', color='#2ca02c')\n",
        "for x, y in zip(layers, reduced):\n",
        "    plt.text(x, y+0.5, f'{y}', ha='center', color='#d62728')\n",
        "for x, y in zip(layers, absent):\n",
        "    plt.text(x, y+0.5, f'{y}', ha='center', color='#9467bd')\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ]
